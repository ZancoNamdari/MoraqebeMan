# کپی این فایل به .env و مقادیر واقعی را جایگزین کنید:
#   cp .env.example .env

# development (پیش‌فرض) | staging | production
DJANGO_ENV=development

# در production الزامی است — بدون آن، startup با خطا متوقف می‌شود
DJANGO_SECRET_KEY=dev-only-secret-change-in-prod

# در production الزامی است — تمام JWT های صادرشده با این کلید امضا می‌شوند
JWT_SIGNING_KEY=change-me-super-secret

# فقط در production استفاده می‌شود (development همه را مجاز می‌داند)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://moraqebeman_user:moraqebeman_pass@postgres:5432/moraqebeman_db
REDIS_URL=redis://redis:6379/0
