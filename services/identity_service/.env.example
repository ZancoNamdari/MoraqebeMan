# Which settings module loads — development (default), staging, or production.
# See config/settings/__init__.py
DJANGO_ENV=development

# Read by config/settings/security.py — NOT "SECRET_KEY". Must be set
# explicitly in production; production.py raises RuntimeError otherwise.
DJANGO_SECRET_KEY=change-me

# Shared across every microservice — identity_service issues JWTs with
# this key, every other service verifies them locally without a network
# round-trip. Must match across all services. Must be set explicitly in
# production; production.py raises RuntimeError otherwise.
JWT_SIGNING_KEY=change-me

# Comma-separated. Only enforced in production (development.py hardcodes ["*"]).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Only enforced in production (development.py allows all origins).
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://identity_user:identity_pass@postgres_identity:5432/identity_db
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
